MONGODB_URI=mongodb://127.0.0.1:27017/warranty360
JWT_SECRET=change-this-secret-in-production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# אימות טלפון: 'external' (ברירת מחדל) שולח ומאמת קוד אמיתי מול wa.message.co.il
# (לפי "תיעוד API לאימות טלפון") - זה שולח SMS/WhatsApp אמיתי, בתשלום, לכל מספר שמוזן!
# 'internal' עובר למצב פיתוח מקומי בלבד (ללא שליחה בפועל, הקוד מודפס ללוג/מוחזר ב-API).
PHONE_AUTH_PROVIDER=external
# PHONE_AUTH_BASE_URL=https://wa.message.co.il/phone-auth.php

# רלוונטי רק כאשר PHONE_AUTH_PROVIDER=internal: מחזיר את הקוד בתשובת ה-API לצורך פיתוח.
OTP_DEMO_MODE=true
